meta {
  name: 07 - Logoff
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/biprws/logoff
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-SAP-LogonToken: {{logonToken}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("logonToken", "");
    console.log("Logged off and token cleared.");
  }
}

tests {
  test("Logoff successful", function () {
    expect(res.getStatus()).to.equal(200);
  });
}