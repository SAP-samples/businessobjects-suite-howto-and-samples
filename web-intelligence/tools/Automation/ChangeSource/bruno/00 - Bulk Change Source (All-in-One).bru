meta {
  name: 00 - Bulk Change Source (All-in-One)
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/biprws/logon/long
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "userName": "{{user}}",
    "password": "{{password}}",
    "auth": "{{auth}}",
    "cms": "{{cms}}"
  }
}

docs {
  ================================================================
  BULK CHANGE SOURCE — ALL IN ONE (single run)
  ================================================================
  This request logs on (the request itself), then in its
  post-response script it:
    1. Reads the `docIds` environment variable (comma-separated).
    2. For each docId:
         - opens the document
         - lists ALL data providers (queries) — handles multi-query docs
         - for each query: changes source to {{targetuniverse}}
           (or DRY RUN if runnerAction = test)
         - saves the document (only when runnerAction = change)
         - closes the session on the document (occurrences/0 -> Unused)
    3. Logs off.
  Clear per-document / per-query logs are printed to the console.

  ENV VARS USED (environments/my-env.bru):
    baseUrl        e.g. http://10.47.226.123:8080   (NO /biprws)
    cms, user, password, auth
    targetuniverse target universe/dataSource id, e.g. 5406
    runnerAction   "change" = perform | "test" = dry run
    docIds         comma-separated document ids, e.g.  5418,5403,62362
    strategyMode   "default" = regular mapping (server's built-in matching)
                   "custom"  = use the strategies we declare (see below)
    mappingStrategies (optional, used only when strategyMode=custom) JSON to
                   override the object-matching strategies. Leave blank to use
                   the safe default:
                     SamePath + SameTechnicalName + SameName enabled,
                     Removal DISABLED (unmatched objects are KEPT, not deleted).

  MAPPING STRATEGY (verified live against the server):
    The mapping is COMPUTED with a GET on
      .../dataproviders/mappings?originDataproviderIds=..&targetDatasourceId=..
      - strategyMode=default : plain GET (server's regular matching)
      - strategyMode=custom  : GET WITH a `strategies` body (our rules)
    The computed mapping is then APPLIED with a POST of that mapping payload,
    and the document is SAVED with an empty-body PUT.
    NOTE: POST with a `strategies` body is rejected (400 WSR 00103), and PUT on
    the mappings url is not supported — strategies belong on the GET.

  DOC IDS — set the `docIds` variable in environments/my-env.bru:
        docIds: 5418,5403,62362
  Add/remove ids there (comma separated) and re-run. All non-empty ids are
  processed; duplicates are ignored. Wrong/missing ids are reported in the
  console (e.g. NOT FOUND / 404) and in the SUMMARY.
  ================================================================
}

script:post-response {
  // ---------------- CONFIG ----------------
  const REST   = bru.getEnvVar("baseUrl") + "/biprws";
  const target = String(bru.getEnvVar("targetuniverse") || "").trim();
  const action = String(bru.getEnvVar("runnerAction") || "change").trim().toLowerCase();
  const dryRun = action === "test";

  // ---------------- MAPPING STRATEGY MODE ----------------
  //  strategyMode (env var) controls HOW the change-source mapping is computed:
  //    "default" -> regular mapping: plain GET, server's built-in matching.
  //    "custom"  -> GET with a `strategies` body (the rules we declare) so YOU
  //                 control matching (SamePath/SameTechnicalName/SameName) and
  //                 keep unmatched objects (Removal disabled).
  //  In "custom" mode the strategies come from env var `mappingStrategies`
  //  (JSON); if that's blank the safe default below is used.
  const strategyMode = String(bru.getEnvVar("strategyMode") || "default").trim().toLowerCase();
  const useCustom = strategyMode === "custom";

  function getStrategies() {
    const raw = String(bru.getEnvVar("mappingStrategies") || "").trim();
    if (raw) {
      try { return JSON.parse(raw); } catch (e) {
        console.log(`  [STRATEGY] invalid mappingStrategies JSON — using built-in default. (${e && e.message ? e.message : e})`);
      }
    }
    return {
      strategies: {
        strategy: [
          { name: "SamePath",          enabled: true  },
          { name: "SameTechnicalName", enabled: true  },
          { name: "SameName",          enabled: true  },
          { name: "Removal",           enabled: false }
        ]
      }
    };
  }
  // Body used when computing the mapping: strategies in custom mode, none in default.
  const STRATEGIES = useCustom ? getStrategies() : undefined;

  // ---------------- DOC IDS ----------------
  //  Edit the `docIds` variable in environments/my-env.bru — a simple
  //  comma-separated list, e.g.   docIds: 5418,5403,62362
  //  (spaces / newlines also accepted). All non-empty ids are processed.
  function parseIds(raw) {
    return String(raw || "")
      .split(/[,\s;]+/)          // split on comma / whitespace / semicolon
      .map(s => s.trim())
      .filter(Boolean)           // drop blanks
      .filter((v, i, a) => a.indexOf(v) === i); // de-duplicate, keep order
  }

  const docIds  = parseIds(bru.getEnvVar("docIds"));
  const idSource = "env var docIds";

  // Capture logon token from this request's response
  let token = res.getHeader("X-SAP-LogonToken");
  if (!token && res.getBody() && res.getBody().logonToken) token = res.getBody().logonToken;
  token = token ? token.toString().replace(/^"|"$/g, "") : "";
  if (token) bru.setEnvVar("logonToken", token);

  const baseHeaders = {
    "Accept": "application/json",
    "Content-Type": "application/json",
    "X-SAP-LogonToken": token
  };

  // ---------------- HELPERS ----------------
  // Bruno's sandbox has NO global fetch. Use the built-in bru.sendRequest,
  // which is always available inside Bruno scripts.
  function sendRequest(options) {
    return new Promise(function (resolve) {
      bru.sendRequest(options, function (err, response) {
        if (err) {
          resolve({ status: 0, ok: false, data: (err && err.message) ? err.message : String(err) });
        } else {
          const status = response && response.status ? response.status : 0;
          resolve({
            status: status,
            ok: status >= 200 && status < 300,
            data: response ? response.data : undefined
          });
        }
      });
    });
  }

  async function api(method, path, body) {
    const options = {
      method: method,
      url: REST + path,
      headers: baseHeaders
    };
    if (body !== undefined) options.data = body;
    return await sendRequest(options);
  }

  function asArray(x) {
    if (!x) return [];
    return Array.isArray(x) ? x : [x];
  }

  function extractDataProviders(payload) {
    // Raylight returns { dataproviders: { dataprovider: [...] } } or single object
    if (!payload) return [];
    const dps = payload.dataproviders || payload;
    return asArray(dps && dps.dataprovider ? dps.dataprovider : dps);
  }

  // ---------------- MAIN ----------------
  async function run() {
    const line = "=".repeat(60);
    console.log(line);
    console.log(`BULK CHANGE SOURCE  |  mode = ${dryRun ? "DRY RUN (test)" : "CHANGE"}  |  target universe = ${target}`);
    console.log(`Strategy: ${useCustom ? "CUSTOM (declared strategies)" : "DEFAULT (regular mapping)"}`);
    console.log(`REST root: ${REST}`);
    console.log(`Doc source: ${idSource}  (${docIds.length} id${docIds.length === 1 ? "" : "s"})`);
    console.log(`Documents to process: ${docIds.join(", ")}`);
    console.log(line);

    if (!docIds.length) { console.log("ABORT: `docIds` is empty in my-env.bru — add ids like  docIds: 5418,5403"); return; }

    if (!token) { console.log("ABORT: no logon token."); return; }
    if (!target) { console.log("ABORT: targetuniverse env var is empty."); return; }

    const summary = [];

    for (const rawId of docIds) {
      const docId = String(rawId == null ? "" : rawId).trim();
      console.log(`\n---- DOC ${docId || "(blank)"} ----`);
      const docResult = { docId, name: "", queries: 0, changed: 0, skipped: 0, failed: 0, status: "OK" };

      // Guard: blank / missing id in the list
      if (!docId) {
        console.log(`  [SKIP] blank/empty docId in list — nothing to process.`);
        docResult.status = "INVALID_ID";
        summary.push(docResult);
        continue;
      }

      try {
        // 1) Open the document
        const open = await api("GET", `/raylight/v1/documents/${docId}`);
        if (!open.ok) {
          if (open.status === 404) {
            // Wrong / non-existent document id
            console.log(`  [OPEN] NOT FOUND — docId ${docId} does not exist (HTTP 404). Check the docIds list in my-env.bru.`);
            console.log(`         server said :: ${JSON.stringify(open.data)}`);
            docResult.status = "NOT_FOUND";
          } else if (open.status === 401 || open.status === 403) {
            console.log(`  [OPEN] NOT AUTHORIZED for docId ${docId} (HTTP ${open.status}).`);
            console.log(`         server said :: ${JSON.stringify(open.data)}`);
            docResult.status = "NOT_AUTHORIZED";
          } else {
            console.log(`  [OPEN] FAILED for docId ${docId} status=${open.status} :: ${JSON.stringify(open.data)}`);
            docResult.status = "OPEN_FAILED";
          }
          summary.push(docResult);
          continue;
        }
        const docName =
          (open.data && open.data.document && (open.data.document.name || open.data.document.id)) || docId;
        console.log(`  [OPEN] ok — "${docName}"`);

        // 2) List ALL data providers (queries)
        const dpResp = await api("GET", `/raylight/v1/documents/${docId}/dataproviders`);
        if (!dpResp.ok) {
          console.log(`  [DATAPROVIDERS] FAILED status=${dpResp.status} :: ${JSON.stringify(dpResp.data)}`);
          docResult.status = "DP_LIST_FAILED";
          summary.push(docResult);
          // still try to close the session below
          await closeDoc(docId);
          continue;
        }
        const providers = extractDataProviders(dpResp.data);
        docResult.queries = providers.length;
        console.log(`  [DATAPROVIDERS] found ${providers.length} quer${providers.length === 1 ? "y" : "ies"}`);

        // 3) Change source per query (data provider) via the MAPPINGS flow:
        //    a) GET  .../dataproviders/mappings?originDataproviderIds={dpId}
        //            &targetDatasourceId={target}&skipChecking=false  -> mapping payload
        //    b) POST same URL with the mapping payload as body        -> applies change
        for (const dp of providers) {
          const dpId   = dp.id;
          const dpName = dp.name || dpId;
          const curSrc = dp.dataSourceId || (dp.dataSource && dp.dataSource.id) || "?";
          const curType = dp.dataSourceType || "";

          const mapPath =
            `/raylight/v1/documents/${docId}/dataproviders/mappings` +
            `?originDataproviderIds=${encodeURIComponent(dpId)}` +
            `&targetDatasourceId=${encodeURIComponent(target)}` +
            `&skipChecking=false`;

          // a) COMPUTE the object mapping (GET). Two modes (env var strategyMode):
          //    - "default": plain GET -> server's regular/built-in matching.
          //                 This is the equivalent of request "04a - Get Mapping".
          //    - "custom":  GET WITH a `strategies` body (verified live: the
          //                 server accepts strategies on the GET compute call).
          //                 This is the equivalent of "04a2 - Get Mapping (with Strategies)".
          //                 POST with a strategies body is rejected (400 WSR
          //                 00103); POST is only for APPLYING the mapping (step b).
          let mapMode = useCustom ? "custom" : "default";
          let viaReq  = useCustom ? "04a2 (GET + strategies)" : "04a (plain GET)";
          console.log(`    - [MAP] query "${dpName}" (${dpId}): computing mapping via ${viaReq} …`);
          let mapCompute = await api("GET", mapPath, STRATEGIES); // STRATEGIES is undefined in default mode
          if (!mapCompute.ok && useCustom) {
            // Fallback: a build might reject a body on GET — retry plain GET.
            console.log(`    - [MAP] 04a2 (GET + strategies) failed (status ${mapCompute.status}) — falling back to 04a (plain GET).`);
            mapCompute = await api("GET", mapPath);
            mapMode = "default(fallback)";
            viaReq  = "04a (plain GET, fallback)";
          }
          if (!mapCompute.ok) {
            docResult.failed++;
            console.log(`    - [MAP:${mapMode}] via ${viaReq} — query "${dpName}" (${dpId}): FAILED status=${mapCompute.status} :: ${JSON.stringify(mapCompute.data)}`);
            continue;
          }

          // Summarise mapping status (Ok / notMapped etc.)
          let mappingArr = [];
          try {
            mappingArr = asArray(mapCompute.data.mappings.content.mapping);
          } catch (e) { mappingArr = []; }
          const notOk = mappingArr.filter(m => m && m["@status"] && String(m["@status"]).toLowerCase() !== "ok");
          console.log(`    - [MAP:${mapMode}] query "${dpName}" (${dpId}): ${mappingArr.length} object mapping(s), ${notOk.length} not-Ok`);

          if (dryRun) {
            console.log(`    - [DRYRUN] query "${dpName}" (${dpId}, ${curType}): would change source ${curSrc} -> ${target} (mapping computed, apply skipped)`);
            docResult.skipped++;
            continue;
          }

          // b) APPLY: POST the computed mapping payload back to change the source
          //    (equivalent of request "04b - Apply Mapping (Change Source)").
          console.log(`    - [APPLY] query "${dpName}" (${dpId}): applying mapping via 04b (POST mapping) …`);
          const mapPost = await api("POST", mapPath, mapCompute.data);
          if (mapPost.ok) {
            docResult.changed++;
            console.log(`    - [CHANGE] query "${dpName}" (${dpId}): source ${curSrc} -> universe ${target}  OK via 04b (status ${mapPost.status})`);
          } else {
            docResult.failed++;
            console.log(`    - [CHANGE] query "${dpName}" (${dpId}): FAILED via 04b status=${mapPost.status} :: ${JSON.stringify(mapPost.data)}`);
          }
        }

        // 4) Save — commit the change back to the CMS repository.
        // The mapping POST (step 3b) updates the in-session document and the
        // server replies "successfully updated", but that does NOT always
        // persist to the repository. An explicit SAVE IN PLACE is done with a
        // PUT /raylight/v1/documents/{docId} using an EMPTY body.
        //   IMPORTANT: sending a JSON state body { "document": { "state": ... } }
        //   is rejected on many patch levels (HTTP 400 / WSR 00103) — that was
        //   the reason the earlier save "did nothing". So we send NO body.
        if (dryRun) {
          console.log(`  [SAVE] n/a — dry run`);
        } else if (docResult.changed > 0) {
          const save = await api("PUT", `/raylight/v1/documents/${docId}`);
          if (save.ok) {
            console.log(`  [SAVE] saved in place — PUT documents/${docId} (status ${save.status})`);
          } else {
            docResult.status = "SAVE_FAILED";
            console.log(`  [SAVE] FAILED status=${save.status} :: ${JSON.stringify(save.data)}`);
          }
        } else {
          console.log(`  [SAVE] nothing changed`);
        }
      } catch (err) {
        console.log(`  [ERROR] ${err && err.message ? err.message : err}`);
        docResult.status = "ERROR";
      } finally {
        // 5) Close the session on this document
        await closeDoc(docId);
      }

      summary.push(docResult);
    }

    // ---------------- SUMMARY ----------------
    console.log(`\n${line}`);
    console.log("SUMMARY");
    console.log(line);
    for (const r of summary) {
      console.log(`  Doc ${r.docId}: status=${r.status}, queries=${r.queries}, changed=${r.changed}, skipped=${r.skipped}, failed=${r.failed}`);
    }
    console.log(line);

    // 6) Logoff
    const off = await api("POST", `/logoff`);
    console.log(`[LOGOFF] status ${off.status}`);
    bru.setEnvVar("logonToken", "");
    console.log("Done.");
  }

  async function closeDoc(docId) {
    try {
      const close = await api(
        "PUT",
        `/raylight/v1/documents/${docId}/occurrences/0`,
        { occurrence: { state: { "$": "Unused" } } }
      );
      console.log(`  [CLOSE] occurrences/0 -> Unused (status ${close.status})`);
    } catch (e) {
      console.log(`  [CLOSE] error: ${e && e.message ? e.message : e}`);
    }
  }

  await run();
}

tests {
  test("Logon (for runner) succeeded", function () {
    expect(res.getStatus()).to.equal(200);
  });
}