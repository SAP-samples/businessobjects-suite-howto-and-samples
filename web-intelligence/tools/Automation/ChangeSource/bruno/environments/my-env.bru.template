// This is a template. Copy it to my-env.bru for local execution.
// The actual my-env.bru is ignored by git via Automation/.gitignore.
vars {
  baseUrl: http://<TOMCAT>:<PORT>
  cms: <CMS Name>:<Port>
  user:
  password:
  auth: secEnterprise
  targetuniverse: <SI_ID of TARGET UNIVERSE>
  runnerAction: <change to perform, or test for a dry run>
  strategyMode: <default or custom>
  docIds: <Comma-separated document ids, e.g. 1234,4567,8910>
  logonToken:
  mappingPayload:
  mappingStrategies: <JSON strategies object, or leave blank to use built-in default>
}