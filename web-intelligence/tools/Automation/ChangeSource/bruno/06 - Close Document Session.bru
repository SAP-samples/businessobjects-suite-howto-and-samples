meta {
  name: 06 - Close Document Session
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/biprws/raylight/v1/documents/{{docId}}/occurrences/0
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-SAP-LogonToken: {{logonToken}}
}

vars:pre-request {
  docId: 5403
}

body:json {
  {
    "occurrence": {
      "state": {
        "$": "Unused"
      }
    }
  }
}

docs {
  Closes/releases the document session (frees the Webi editing slot).
  VERIFIED live: PUT /biprws/raylight/v1/documents/{docId}/occurrences/0 => 200
}

tests {
  test("Session closed", function () {
    expect(res.getStatus()).to.equal(200);
  });
}